# BasicFinancialStatementFlow

main: kit: flow: BasicFinancialStatementFlow:
{
  entity: "financial_statement",
  kind: "basic",
  name: "BasicFinancialStatementFlow",
  step: [
    {
      i: {
        ref: "financial_statement_ref01",
        srcdatavar: "financial_statement_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-financial_statement_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFinancialStatementFlow"
}