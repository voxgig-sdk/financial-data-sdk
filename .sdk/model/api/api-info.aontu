# API Information


main: {
  kit: {
    info: {
      contact: {
        url: "https://financialdata.net/documentation"
      }
      description: "This API provides access to a wide range of financial data including market data, company fundamentals, and alternative data. Users can make requests to retrieve stock symbols, prices, company information, ESG scores and ratings, mutual fund holdings, and more. The data covers thousands of securities including stocks, ETFs, funds, and commodities."
      security: {
        in: "query"
        name: "key"
        prefix: ""
        scheme: "ApiKeyAuth"
        type: "apiKey"
      }
      servers: [
        {
          description: "Production server"
          url: "https://financialdata.net/api/v1"
        }
      ]
      summary: "This API provides access to a wide range of financial data including market data, company fundamentals, and alternative data."
      title: "Financial Data API"
      version: "1.0.0"
      website: "https://financialdata.net"
    }
  }
}

